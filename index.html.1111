<section class="contact" id="contact">
  <div class="container">
    <div class="contact-wrap">
      <div class="contact-info reveal">
        <div class="divider" style="margin-left:0;"></div>
        <span class="eyebrow">Contact</span>
        <h2 class="heading">Let's Build Your Property's <em>Success Together.</em></h2>
        <p>We'd love to hear about your property and discuss how Bennett Luxe Stays can help you unlock its full potential.</p>
        <div class="c-row">
          <div class="c-ico">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
          </div>
          <div>
            <div class="l">Email</div>
            <div class="v">gabe@bennettluxestays.com</div>
          </div>
        </div>
      </div>

      <form class="cf reveal" onsubmit="handleSubmit(event)" action="https://formspree.io/f/xgorrzlp" method="POST">
        <h3>Send a Message</h3>
        <div class="frow">
          <div class="ff"><label>First Name</label><input type="text" required /></div>
          <div class="ff"><label>Last Name</label><input type="text" required /></div>
        </div>
        <div class="frow">
          <div class="ff"><label>Email</label><input type="email" required /></div>
          <div class="ff"><label>Phone</label><input type="tel" /></div>
        </div>
        <div class="ff full" style="margin-bottom:22px;">
          <label>Property Location</label>
          <input type="text" placeholder="City, State" />
        </div>
        <div class="ff full" style="margin-bottom:22px;">
          <label>Tell Us About Your Property</label>
          <textarea placeholder="Property type, size, goals..."></textarea>
        </div>
        <button type="submit" class="btn btn-gold">Send Message</button>
      </form>
    </div>
  </div>
</section>

